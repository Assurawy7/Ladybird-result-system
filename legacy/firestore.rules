rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone using the app (even anonymously, which this app signs everyone
    // in as automatically) can read/write. This blocks casual public
    // internet access to your Firestore console URL, but it does NOT give
    // you real per-role backend security - see README section 8.
    match /records/{docId} {
      allow read, write: if request.auth != null;
    }
    match /media/{docId} {
      allow read, write: if request.auth != null;
    }

    // Everything else: denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
