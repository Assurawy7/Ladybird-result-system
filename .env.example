# Copy this file to .env for local `netlify dev`, and set the same values
# as environment variables in the Netlify dashboard (Site settings ->
# Environment variables) for production. Never commit a real .env file.

# ---- PRODUCTION ENVIRONMENT (required on Netlify) ----

# Neon connection string (Neon dashboard -> your project -> Connection Details
# -> "Pooled connection" string). Must be kept secret - the browser never
# sees this; only netlify/functions/*.js do (see netlify/functions/_db.js).
DATABASE_URL=postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Not currently used to SIGN cookies (sessions are looked up by a hashed
# random token stored in the `sessions` table - see netlify/functions/_auth.js),
# but reserved for a future HMAC-signed-cookie upgrade. Set it anyway to a
# long random value.
SESSION_SECRET=replace-with-a-long-random-secret

# First-time setup lock. Leave this UNSET in normal use. Only when creating a
# brand-new school (empty database): set ALLOW_SEED=true, redeploy, open the
# site once so it creates the school, then DELETE this variable again. While
# it is unset, nobody can create a school on an empty database.
# ALLOW_SEED=true

# Cloudflare R2 (media storage - photos, logo, stamp, signatures). See
# docs/migration.md "Media storage: Cloudflare R2" for how to create these.
# The bucket stays PRIVATE - these credentials are only ever used server-side
# in netlify/functions/_r2.js, never sent to the browser.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=ladybird-media


# ---- AI REPORT COMMENTS (optional - FREE services work) ----
# "Generate AI Comments for Entire Class" (Class Review). If none of these is
# set the feature still works: it uses the built-in smart writer instead.
# Keys are read only by netlify/functions/ai-comments.js and never reach the
# browser. Student names / admission numbers are never sent to the AI.
# Full guide: docs/ai-comments.md
#
# Option 1 (recommended, free): Groq - key from https://console.groq.com/keys
GROQ_API_KEY=replace-with-your-groq-key
# GROQ_MODEL=openai/gpt-oss-120b
# Option 2 (free tier): Google Gemini - key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=replace-with-your-gemini-key
# GEMINI_MODEL=gemini-2.5-flash
# Option 3: any other OpenAI-compatible service
# AI_API_KEY=...
# AI_BASE_URL=https://example.com/v1
# AI_MODEL=model-name
# Switch AI off entirely (built-in writer only):
# AI_ENABLED=false


# ---- LOCAL MIGRATION ENVIRONMENT (only needed once, on your own machine,
#      to run scripts/migrate-firebase-to-neon.js and
#      scripts/verify-migration.js - never set these in Netlify) ----

# Path to a Firebase service-account JSON key (Firebase console -> Project
# settings -> Service accounts -> Generate new private key). Keep this file
# OUTSIDE the repository and never commit it.
FIREBASE_SERVICE_ACCOUNT=./service-account.local.json
