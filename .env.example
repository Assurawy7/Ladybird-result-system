# Copy this file to .env for local `netlify dev`, and set the same values
# as environment variables in the Netlify dashboard (Site settings ->
# Environment variables) for production. Never commit a real .env file.

# ---- PRODUCTION ENVIRONMENT (required on Netlify) ----

# Neon connection string (Neon dashboard -> your project -> Connection Details
# -> "Pooled connection" string). Must be kept secret - the browser never
# sees this; only netlify/functions/*.js do (see netlify/functions/_db.js).
DATABASE_URL=postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Not currently used to SIGN cookies (sessions are looked up by a hashed
# random token stored in the `sessions` table - see netlify/functions/_auth.js),
# but reserved for a future HMAC-signed-cookie upgrade. Set it anyway to a
# long random value.
SESSION_SECRET=replace-with-a-long-random-secret


# ---- LOCAL MIGRATION ENVIRONMENT (only needed once, on your own machine,
#      to run scripts/migrate-firebase-to-neon.js and
#      scripts/verify-migration.js - never set these in Netlify) ----

# Path to a Firebase service-account JSON key (Firebase console -> Project
# settings -> Service accounts -> Generate new private key). Keep this file
# OUTSIDE the repository and never commit it.
FIREBASE_SERVICE_ACCOUNT=./service-account.local.json
